# 本地开发环境配置示例
# 复制此文件为 application-local.yml 并填入真实配置
# application-local.yml 已在 .gitignore 中排除，不会提交到版本库

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/teammatch?useUnicode=true&characterEncoding=utf8mb4&serverTimezone=Asia/Shanghai&useSSL=false
    username: root
    password: your_password_here
  
  data:
    redis:
      host: localhost
      port: 6379
      password: 
      database: 0

server:
  port: 8080

logging:
  level:
    com.teammatch: DEBUG
